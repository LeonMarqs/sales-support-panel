type Query {
    getCampaigns(filter: CampaignFilter): [Campaign]!
    campaign(id: ID!): Campaign
}

type Mutation {
    createCampaign(name: String!, startDate: String, budget: Float, platform: CampaignPlatform): Campaign!
    deleteCampaign(id: ID!): Boolean!
    activateCampaign(id: ID!): Campaign!
    pauseCampaign(id: ID!): Campaign!
    completeCampaign(id: ID!): Campaign!
    archiveCampaign(id: ID!): Campaign!

}

type Campaign {
    id: ID!
    name: String!
    startDate: String
    budget: Float
    status: CampaignStatus!
    platform: CampaignPlatform
}

enum CampaignStatus {
    DRAFT
    ACTIVE
    PAUSED
    COMPLETED
    ARCHIVED
}

enum CampaignPlatform {
    GOOGLE_ADS
    FACEBOOK_ADS
    INSTAGRAM_ADS
    LINKEDIN_ADS
    TWITTER_ADS
    TIKTOK_ADS
    SNAPCHAT_ADS
    YOUTUBE_ADS
    OTHER
}

input CampaignFilter {
    name: String
    startDate: String
    endDate: String
    budget: Float
    status: CampaignStatus
}
