type Query {
    getCampaigns(filter: CampaignFilter): [Campaign]!
    campaign(id: ID!): Campaign
}

type Mutation {
    createCampaign(name: String!, startDate: String, budget: Float): Campaign!
    deleteCampaign(id: ID!): Boolean!
}

type Campaign {
    id: ID!
    name: String!
    startDate: String
    budget: Float
}

input CampaignFilter {
    name: String
    startDate: String
    endDate: String
    budget: Float
}
